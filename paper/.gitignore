# LaTeX build artefacts.  main.pdf is tracked on purpose, so a teammate can read
# the current paper without a TeX install; everything here is regenerated by
#   pdflatex main && bibtex main && pdflatex main && pdflatex main
*.aux
*.log
*.out
*.blg
*.bbl
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# figs/overview.tex is a standalone document and leaves its own droppings
figs/*.aux
figs/*.log

# Local v3 rendering and build diagnostics, regenerated during review.
tmp/
build_v3.txt
bib_v3.txt
