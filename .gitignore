# ---------------------------------------------------------------- environments
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------- raw data
# 430 MB, and fully regenerable: proj1/scripts/prepare_qm9.py rebuilds
# data/qm9.pt from the GDB-9 download. Never commit it.
data/

# ---------------------------------------------------------------- cluster pulls
# 582 MB of checkpoints-with-optimiser-state and job logs synced off Betty.
# The inference-ready weights live in weights/ instead (see weights/README.md).
betty_pull/

# ---------------------------------------------------------------- vendored repos
# Cloned reference implementations used for the prior-art audit, ~146 MB
# including a 75 MB log. Read-only references, not our code.
#
# TWO SUBTREES ARE EXEMPT AND MUST STAY TRACKED. `proj1/src/external/
# tfg_assets.py` loads model definitions and checkpoints from them at import
# time, so the transfer experiment -- the gate script, the sweep and all 61
# backend gates -- does not run at all from a fresh clone without them. They
# were ignored until 22 Sep 2026, which made the whole harness reproducible
# only on the machine that wrote it. ~105 MB, deliberately committed; see
# audit/fa_fb_search/PROVENANCE.md for origin, commit and licence.
#
# Un-ignoring a subtree needs its parents re-included first: git does not
# descend into an excluded directory, so `!audit/fa_fb_search/TFG/` alone
# would do nothing.
audit/*
!audit/fa_fb_search/
audit/fa_fb_search/*
!audit/fa_fb_search/PROVENANCE.md
!audit/fa_fb_search/TFG/
!audit/fa_fb_search/OC-Flow/

# ...but not TFG's own training logs or the scraped Drive listings. The log
# alone is 79 MB -- three quarters of the subtree, and of no use to anyone
# reading this repository. Nothing in proj1/ opens either.
audit/fa_fb_search/TFG/**/logs.txt
audit/fa_fb_search/TFG/*.html

# The BDG review's evidence (25 Sep 2026): every math check, data check,
# defence script and the full agent record that docs/methods/BDG_REVIEW.md
# cites as its provenance. ~2.4 MB of scripts and JSON. Tracked so that the
# review's numbers can be re-run from a clone, not only from the machine
# that produced them.
!audit/bdg_review/

# ---------------------------------------------------------------- scratch
tmp/
scratch_schnet/
output/
_ship/
transfer/
code_*.tgz

# ---------------------------------------------------------------- local-only docs
# Brainstorms, dropped ideas, superseded reviews and the cluster guide (which
# contains absolute /vast paths). Kept on disk for reference -- every one of
# them is cited from docs/methods/GUIDANCE_METHODS_INDEX.md so nothing is lost
# to a reader, and section 3 of that index records why each was dropped.
archive/

# ---------------------------------------------------------------- large binaries
# Sample dumps from the benchmark runs: results/bench is ~287 MB, almost all of
# it .pt tensors that are regenerable from the JSON + a seed. The JSONs ARE
# committed -- they are the experimental record.
results/bench/**/*.pt
results/bench/audit*/
results/sweep_smoke/
results/sweep_unguided/
proj1/checkpoints/*.pt
proj1/logs/

# ...but keep the inference-ready weights we publish deliberately
!weights/*.pt

# ---------------------------------------------------------------- build artefacts
*.tar.gz
*.tgz

# ---------------------------------------------------------------- reference papers
# Downloaded PDFs of the prior-art we compare against (~31 MB). Cited properly
# in docs/methods/GUIDANCE_METHODS_INDEX.md; no need to redistribute them.
results/bench/papers/

# ---------------------------------------------------------------- bulk benchmark dumps
# results/bench holds ~287 MB, mostly per-sample dumps from the base-model
# benchmark: each *_euler_s*.json / *_heun_s*.json is ~2 MB of per-molecule
# records. The HEADLINE numbers they produced are in
# docs/results/BASE_MODEL_BENCHMARK.md, and the analysis scripts that rebuild
# them are kept. The dumps themselves are regenerable from a seed.
results/bench/*_euler_*.json
results/bench/*_heun_*.json
results/bench/rescored/
results/bench/dataset_smiles.json
results/bench/conv_*.json
results/bench/calib_*.json
results/bench/ep0*.json
results/bench/ep1*.json

# ---------------------------------------------------------------- third-party weights
# TFG's released EDMsecond generator, 21 MB, used by the transfer experiment.
# NOT ours to redistribute, and one command rebuilds it:
#   python proj1/scripts/fetch_tfg_assets.py --models EDMsecond
weights/EDMsecond/

# ---------------------------------------------------------------- extracted paper text
# Full text dumps of EDM and EEGSDE, produced while verifying the dist
# protocol's citations. Third-party copyrighted text; the quotes we rely on are
# reproduced with their section numbers in docs/protocol/DIST_PROTOCOL.md.
edm_full.txt
eegsde_full.txt

# ---------------------------------------------------------------- derived caches
# f_B's predictions on the 13,083 real test molecules, rebuilt in ~1 min by
# dist_report.py whenever they are missing.
results/dist_fB_test_*.pt

# ---------------------------------------------------------------- cluster logs
logs/

# ---------------------------------------------------- modality 2 artefacts
# Checkpoints are regenerable from proj1/m2/simplex_fm.py and are tens of MB.
proj1/m2/ckpt/
proj1/m2/logs/
proj1/m2/*.bak_*
# The bundle directory IS tracked (blade needs it); the tarball duplicates it.
proj1/m2/blade_bundle.tgz

# a build artefact: 35 MB of weights already tracked under audit/ and weights/
bobo_v3_benchmark.zip
*.zip

# editor state
.vscode/

# Per-cell sample tensors: the generated molecules/sequences themselves.
# ~300 MB, which would quadruple the repo for every clone, so they stay on
# blade at /scratch2/boboli/projects/cis6270-project1-group2/results/.
# The stats JSONs beside them ARE tracked, so every reported number is here.
# M2 samples regenerate EXACTLY from the seed (verified bit-for-bit,
# ~1.2 min/cell): proj1/m2/backfill_samples.py replays a cell, checks the
# regenerated JSON matches the committed one, and only then writes the samples.
*.permol.pt
